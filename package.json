{
  "name": "dsh-chat-wallpaper",
  "description": "Chat-background wallpaper plugin for DeepSeek Harness: local image / URL / Wallpaper Engine library / desktop-transparent chat backgrounds, 13-color text palette, text opacity, adjustable white outline, code-background toggle, plus a transparent chat shell (tools/chat-desktop). Published as a DSH Hub Profile Bundle.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js",
    "lib/types/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.4 <5.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <0.2.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
